  <Target Name="BuildEmbeddedUpdater" BeforeTargets="PrepareResourceNames">
    <Exec Command="dotnet publish &quot;$(MkwvcUpdaterProject)&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(MkwvcUpdaterPublishDir)&quot;" />
    <Error Condition="!Exists('$(MkwvcUpdaterPublishDir)MKWVoiceChat-Updater.exe')" Text="MKW VoiceChat bootstrap updater publish did not produce MKWVoiceChat-Updater.exe." />
  </Target>

  <Target Name="LoadMkwvcProductVersion" BeforeTargets="GetAssemblyVersion">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $m=Get-Content -LiteralPath '$(MkwvcVersionFile)' -Raw | ConvertFrom-Json; if([string]::IsNullOrWhiteSpace([string]$m.productVersion)){throw 'version.json productVersion is missing'}; Write-Output ([string]$m.productVersion)&quot;"
      ConsoleToMSBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="Version" />
    </Exec>
  </Target>
  <Target Name="PrepareRnnoiseModel" BeforeTargets="PrepareResourceNames">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\prepare_rnnoise_model.py&quot; --fetch &quot;$(MSBuildThisFileDirectory)..\..\third_party\rnnoise\src\rnnoise_data.c&quot;" />
  </Target>
</Project>

