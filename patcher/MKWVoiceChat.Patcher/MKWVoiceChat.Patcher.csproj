<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>WiiCompiled-VoiceChat-Installer</AssemblyName>
    <RootNamespace>MKWVoiceChat.Patcher</RootNamespace>
    <MkwvcVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\\..\\version.json'))</MkwvcVersionFile>
    <MkwvcUpdaterProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\\MKWVoiceChat.Updater\\MKWVoiceChat.Updater.csproj'))</MkwvcUpdaterProject>
    <MkwvcUpdaterPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)obj\\embedded-updater\\$(Configuration)\\'))</MkwvcUpdaterPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\\..\\version.json"
                      LogicalName="MKWVoiceChat.Patcher.version.json" />
    <EmbeddedResource Include="$(MkwvcUpdaterPublishDir)MKWVoiceChat-Updater.exe"
                      LogicalName="MKWVoiceChat.Patcher.Updater.MKWVoiceChat-Updater.exe" />

